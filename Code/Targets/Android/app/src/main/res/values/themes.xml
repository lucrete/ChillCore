<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- AppCompat-derived theme (required by GameActivity), no action bar.
         The engine's GLES surface fills the window; window decorations are
         hidden by MainActivity.hideSystemUi() on focus-gain. -->
    <style name="Theme.ChillCore" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
