// Per-draw uniform buffer. Bound by Gfx::RenderApi::SetPushConstants.
// Engine-side layout: CC::ObjectUniforms in Code/Core/Rendering/ObjectUniforms.h.
// Slot must match OBJECT_UNIFORMS_BINDING_SLOT in Code/Core/Rendering/UniformBindings.h.
// Sized to 128 bytes — UpdateFrequency::Draw, mapped to native push
// constants on a Vulkan backend and root constants on D3D12.
layout(std140, binding = 2) uniform ObjectUniforms
{
    mat4 mvp;
    mat4 model;
} objectUniforms;
